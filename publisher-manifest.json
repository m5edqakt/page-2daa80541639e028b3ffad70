splay: grid;grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));gap: 1.5rem;margin-top: 2rem}\n.card {border: 3px solid var(--border-color);background: var(--bg-color);padding: 2rem;box-shadow: 6px 6px 0px var(--border-color)}\n.card h3 {font-size: 1.3rem;font-weight: 800;margin-bottom: 0.5rem}\n.card .metric {font-size: 2.2rem;font-weight: 900;color: var(--accent-color);margin-bottom: 0.5rem}\n.plans-table-container {overflow-x: auto;margin-top: 2rem}\ntable.plans-table {width: 100%;border-collapse: collapse;border: 3px solid var(--border-color);text-align: left}\ntable.plans-table th, table.plans-table td {border: 2px solid var(--border-color);padding: 1rem 1.5rem}\ntable.plans-table th {background-color: var(--accent-light);font-weight: 800;font-size: 1.2rem}\ntable.plans-table td {background-color: var(--bg-color)}\n.featured-badge {background: var(--accent-color);color: white;padding: 0.2rem 0.5rem;font-size: 0.8rem;font-weight: bold;text-transform: uppercase;display: inline-block;margin-bottom: 0.5rem}\n.faq-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));gap: 2rem;margin-top: 2rem}\n.faq-item {border: 3px solid var(--border-color);padding: 1.5rem;background: var(--panel-bg)}\n.faq-item h3 {font-size: 1.1rem;font-weight: 800;margin-bottom: 0.8rem;color: var(--text-color)}\n.faq-item p {font-size: 1rem;margin-bottom: 0}\n.cta-box {border: 3px solid var(--border-color);background-color: var(--accent-light);padding: 3rem;display: flex;flex-direction: column;align-items: flex-start;gap: 1.5rem}\n.btn {background: var(--accent-color);color: white;padding: 1rem 2rem;font-weight: 800;font-size: 1.1rem;border: 3px solid var(--border-color);text-decoration: none;box-shadow: 4px 4px 0px var(--border-color);transition: transform 0.1s, box-shadow 0.1s}\n.btn:hover {transform: translate(-2px, -2px);box-shadow: 6px 6px 0px var(--border-color)}\n</style><aside>\n  <div>\n    <a href=\"#\" class=\"logo\">云平台<span>.</span></a>\n    <ul class=\"nav-menu\">\n      <li><a href=\"#overview\">仪表盘概览</a></li>\n      <li><a href=\"#features\">核心优势</a></li>\n      <li><a href=\"#plans\">服务套餐</a></li>\n      <li><a href=\"#faq\">常见问题</a></li>\n    </ul>\n  </div>\n  <div class=\"aside-footer\">\n    <p>© 云平台 现代化网络与数据支持</p>\n  </div>\n</aside>\n\n<main>\n  <section id=\"overview\">\n    <h1>告别网络延迟，<br>欢迎来到<span>云平台</span>世界</h1>\n    <p>嘿！很高兴能在这里向你介绍我们的服务。我们专为追求高效、稳定网络体验的朋友们打造。来看看我们为你准备的实时运行状态与核心数据拼贴：</p>\n    \n    <div class=\"dashboard-grid\">\n      <div class=\"card\">\n        <h3>全网节点</h3>\n        <div class=\"metric\">100+</div>\n        <p>精选优质骨干线路，随时随地触达全球。</p>\n      </div>\n      <div class=\"card\">\n        <h3>在线率保障</h3>\n        <div class=\"metric\">99.9%</div>\n        <p>多重冗余备份，全天候守护你的连接不断线。</p>\n      </div>\n      <div class=\"card\">\n        <h3>平均延迟</h3>\n        <div class=\"metric\">&lt; 35ms</div>\n        <p>极致优化路由，告别卡顿与加载转圈。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"features\">\n    <h2>为什么大家都在用它？</h2>\n    <p>我们相信科技应该让生活更轻松。没有复杂的配置，也没有晦涩的术语，一切都为你准备就绪。</p>\n    \n    <div class=\"dashboard-grid\">\n      <div class=\"card\">\n        <h3>一键轻松上手</h3>\n        <p>不管你用的是什么设备，只需简单的导入和点击，即可瞬间开启畅快之旅。</p>\n      </div>\n      <div class=\"card\">\n        <h3>多设备随心切换</h3>\n        <p>手机、平板、笔记本同时在线，一个账号满足你所有的日常连接需求。</p>\n      </div>\n      <div class=\"card\">\n        <h3>流媒体与专线优化</h3>\n        <p>原生解锁各大流媒体平台，更配有游戏专项优化，满足全方位的娱乐与工作需求。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <h2>灵活透明的套餐选择</h2>\n    <p>无论你是轻度使用者，还是对带宽有极高要求的团队，这里总有一款适合你。没有任何隐藏费用，按需选择，随时升级。</p>\n    \n    <div class=\"plans-table-container\">\n      <table class=\"plans-table\">\n        <thead>\n          <tr>\n            <th>服务特性</th>\n            <th>基础版</th>\n            <th>旗舰版 <span>最受欢迎</span></th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td><strong>价格</strong></td>\n            <td>¥15/月<br><small>年付 ¥150/年</small></td>\n            <td>¥35/月<br><small>年付 ¥350/年</small></td>\n            <td>¥85/月<br><small>年付 ¥850/年</small></td>\n          </tr>\n          <tr>\n            <td><strong>极速流量</strong></td>\n            <td>每月 100GB</td>\n            <td>每月 300GB</td>\n            <td>每月 1000GB</td>\n          </tr>\n          <tr>\n            <td><strong>设备在线</strong></td>\n            <td>支持 3 台设备</td>\n            <td>支持 5 台设备</td>\n            <td>支持 20 台设备</td>\n          </tr>\n          <tr>\n            <td><strong>核心权益</strong></td>\n            <td>普通线路节点池<br>解锁基础流媒体</td>\n            <td>全节点原生流媒体解锁<br>IPLC 专线游戏加速优化</td>\n            <td>VIP 专属高带宽节点<br>支持企业定制路由</td>\n          </tr>\n          <tr>\n            <td><strong>技术支持</strong></td>\n            <td>标准社区支持</td>\n            <td>7x24 优先工单支持</td>\n            <td>专属客户经理服务</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <h2>常见问题解答</h2>\n    <p>如果你在使用的过程中遇到了小疑问，不妨先在这里找找答案。当然，随时欢迎联系我们的小伙伴！</p>\n    \n    <div class=\"faq-grid\">\n      <div class=\"faq-item\">\n        <h3>购买后如何开始使用？</h3>\n        <p>非常简单！购买完成后，你会在后台看到专属的订阅链接或一键导入按钮，按照提示导入到你习惯的客户端内即可开始使用。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>支持哪些主流客户端设备？</h3>\n        <p>我们全面支持市面上主流的各类操作系统与客户端工具，无论你是 Windows、macOS、iOS 还是 Android 用户，都能完美适配。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>流量不够用了可以升级吗？</h3>\n        <p>完全可以！你可以随时在用户后台选择补差价升级到更高阶的套餐，系统会立刻为你实时开通对应权益。</p>\n      </div>\n      <div class=\"faq-item\">\n        <h3>遇到连接问题怎么办？</h3>\n        <p>别担心，我们有详细的新手使用文档。如果仍未解决，旗舰版与团队版用户可享受 7x24 小时优先工单支持，我们随时为你排忧解难。</p>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"cta-box\">\n      <h2>准备好体验顺滑如丝的网络了吗？</h2>\n      <p>加入我们，告别延迟卡顿，让数字生活重新高效运转起来。</p>\n      <a href=\"#plans\" class=\"btn\">立即挑选心仪套餐</a>\n    </div>\n  </section>\n</main>",
